# Copy this file to .env and fill in your own values.
# .env is ignored by git.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=8787
PUBLIC_APP_URL=http://localhost:8787

# Comma-separated browser origins allowed to call the API.
# PUBLIC_APP_URL, localhost:5173, localhost:4173, and port 8787 are always allowed.
# Production: add your deployed origin, for example:
# CORS_ORIGIN=https://myoz.example.com
# Use * only for throwaway local testing.
CORS_ORIGIN=http://localhost:5173,http://localhost:8787

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
AUTH_USERNAME=adriel
AUTH_PASSWORD=replace-with-a-long-password
AUTH_DISPLAY_NAME=Adriel
AUTH_TOKEN_TTL=7d

# Generate a production secret with: openssl rand -hex 48
# Rotating this value signs every existing session out.
JWT_SECRET=

# ---------------------------------------------------------------------------
# OpenRouter / Gemma
# ---------------------------------------------------------------------------
# Free Gemma 4 (no credits needed, rate limited):
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
#
# Cheapest paid Gemma 4 (more reliable, ~$0.07 per 1M input tokens):
# OPENROUTER_MODEL=google/gemma-4-26b-a4b-it
#
# Optional vision model for the image button. Must accept image_url messages.
# Defaults to OPENROUTER_MODEL when left blank.
OPENROUTER_VISION_MODEL=

# Without a key the app still works using its offline deadline parser.
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# MongoDB
# ---------------------------------------------------------------------------
# Optional. Paste the full connection string, including the username/password.
# The server pings this database on boot and reports it at /api/health.
# Example: mongodb+srv://user:password@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=my-oz
